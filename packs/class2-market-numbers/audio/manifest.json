 "hi": {
  "नमस्ते बच्चो! आज हम गिनती का खेल खेलेंगे। मैं सवाल पूछूँगी। तुम सब मिलकर ज़ोर से जवाब बोलो, या रंग वाला बटन दबाओ।": "f84719f3b1d327e7.mp3",
  "आज गाँव में हाट लगा है। मीना की माँ टमाटर और प्याज़ बेचती हैं। राजू के दादाजी केले बेचते हैं। दादाजी के केले के गुच्छे में बारह केले हैं। कुएँ के पास बकरियाँ बँधी हैं। चलो, हम सब गिनते हैं!": "abdbd4c134b4e03a.mp3",
  "दादाजी के गुच्छे में बारह केले हैं। राजू ने एक केला खा लिया। अब कितने केले बचे?": "a2b0f4a84b9807b6.mp3",
  "एक केला खाने से केले कम होते हैं। बारह में से एक कम करो।": "04b5c6ed2fceb05b.mp3",
  "उत्तर ग्यारह है, क्योंकि बारह में से एक कम करने पर ग्यारह बचते हैं।": "cabc04925e31473c.mp3",
  "शाबाश! बिल्कुल सही!": "a10677e35097cdaa.mp3",
  "लाल बटन — तेरह": "6ef5b2fcc836c474.mp3",
  "नीला बटन — ग्यारह": "299cd16ecfa495ae.mp3",
  "हरा बटन — दस": "bdf5995a3804d774.mp3",
  "मीना ने टोकरी में चार टमाटर रखे। फिर तीन और टमाटर रखे। अब कुल कितने टमाटर हो गए?": "1f47f75701b9eb18.mp3",
  "उँगलियों पर गिनो। पहले चार उँगलियाँ दिखाओ, फिर तीन और।": "32ae55028f194ade.mp3",
  "उत्तर सात है, क्योंकि चार और तीन मिलकर सात होते हैं।": "dbb51e75a9f6355a.mp3",
  "वाह! बहुत अच्छा गिना!": "b607bf37a71c073a.mp3",
  "लाल बटन — छह": "f6e7e65eb490ec10.mp3",
  "नीला बटन — आठ": "5fc815743e497a29.mp3",
  "हरा बटन — सात": "e04f621092fb0a0f.mp3",
  "मीना की माँ के पास दो टोकरियाँ हैं। एक टोकरी में सत्रह प्याज़ हैं। दूसरी टोकरी में बारह प्याज़ हैं। किस टोकरी में कम प्याज़ हैं?": "509a9a1780ca600c.mp3",
  "याद करो, गिनती में जो संख्या पहले आती है, वह कम होती है।": "81fc385eb65fd94a.mp3",
  "बारह प्याज़ कम हैं, क्योंकि गिनती में बारह, सत्रह से पहले आता है।": "285f9ff3ab3867b8.mp3",
  "बहुत बढ़िया! तुमने सही पहचाना!": "82fbccd95ba78d19.mp3",
  "पीला बटन — सत्रह प्याज़": "0cc2165f83ec606d.mp3",
  "लाल बटन — बारह प्याज़": "d0f2f6043ac5c6a6.mp3",
  "कुएँ के पास तेरह बकरियाँ बँधी हैं। एक और बकरी आ गई। अब कितनी बकरियाँ हो गईं?": "f88ec36fe4364a41.mp3",
  "एक बकरी आने से बकरियाँ बढ़ती हैं। तेरह से आगे बस एक गिनो।": "2790c6caaaf08325.mp3",
  "उत्तर चौदह है, क्योंकि तेरह से एक ज़्यादा चौदह होता है।": "985c841665547cce.mp3",
  "शाबाश! एकदम सही!": "1c8b292e8c1c9753.mp3",
  "लाल बटन — बारह": "f53fdb221a94b463.mp3",
  "नीला बटन — चौदह": "bbaf22a45ab893a4.mp3",
  "पीला बटन — पंद्रह": "2f8f6a5b3e087feb.mp3",
  "चलो, रॉकेट की तरह उल्टी गिनती करें। बीस, उन्नीस, अठारह... आगे कौन सी संख्या आती है?": "b977ced7eb0c39b3.mp3",
  "उल्टी गिनती में हर बार संख्या एक कम होती है।": "c44de4fb285cb488.mp3",
  "उत्तर सत्रह है, क्योंकि उल्टी गिनती में अठारह के बाद एक कम यानी सत्रह आता है।": "1565772941a8225c.mp3",
  "वाह! तुम्हारा रॉकेट उड़ गया!": "368f198e6f869036.mp3",
  "लाल बटन — उन्नीस": "144795887b9a6938.mp3",
  "नीला बटन — सत्रह": "372fa74f3d68a514.mp3",
  "पीला बटन — सोलह": "81d312b81711a22c.mp3",
  "उल्टी गिनती मतलब बड़ी संख्या से नीचे की ओर गिनना। बीस, उन्नीस, अठारह — हर बार एक कम।": "46b377dca30898be.mp3",
  "गिनती में जो संख्या बाद में आती है वह ज़्यादा, और जो पहले आती है वह कम।": "64c55d28876f136f.mp3",
  "एक ज़्यादा मतलब गिनती में ठीक अगली संख्या। एक कम मतलब ठीक पहले वाली संख्या।": "99235f2296b7ff16.mp3",
  "पहले पहली संख्या जितनी उँगलियाँ दिखाओ। फिर और उँगलियाँ खोलो। सारी उँगलियाँ गिनो, उतने कुल हैं।": "bfc9cbaad7a7a366.mp3",
  "दादाजी के केले के गुच्छे में बारह केले थे।": "636b0cd0b09f470f.mp3",
  "बहुत अच्छा सवाल है! इसे याद रखो और बाद में अपने शिक्षक से पूछना।": "3ca06ab81e185219.mp3",
  "वाह! आज तुम सबने बहुत अच्छा गिना। घर जाते समय रास्ते में दिखने वाली चीज़ें गिनना। फिर मिलेंगे!": "5fd56026ebdb793e.mp3",
  "अब जवाब बोलो, या रंग वाला बटन दबाओ।": "a382d37e27a0a917.mp3",
  "मुझे ठीक से सुनाई नहीं दिया। एक बार फिर, सब मिलकर।": "85bfcff97ffa08c2.mp3",
  "एक बार और सोचो।": "f466d366ed4a7305.mp3",
  "अपना सवाल पूछो।": "d5ffb374adce23bf.mp3",
  "चलो, अगला सवाल।": "68c65119edc3a05f.mp3",
  "लाल": "b46eba62e6eff0ab.mp3",
  "नीला": "5a690d93e974286b.mp3",
  "हरा": "728607026908825b.mp3",
  "पीला": "f71221a4231994f9.mp3",
  "कक्षा का अभ्यास पूरा हुआ।": "5502d413ec74236e.mp3",
